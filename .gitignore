# ==============================================================================
# .gitignore pro nasazení na Streamlit Community Cloud (streamlit.app)
# Do repozitáře jdou pouze soubory potřebné pro běh aplikace a cermat.db
# ==============================================================================

# Python virtuální prostředí a balíčkovací cache
.venv/
venv/
env/
.uv_cache/
uv.lock

# Python cache & build soubory
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Dočasné transakční soubory SQLite (samotná databáze cermat.db v gitu ZŮSTÁVÁ)
*.db-wal
*.db-shm
*.db-journal

# Archivní a stažené surové datové soubory (pro běh aplikace na streamlit.app nejsou potřeba)
archive/
data/

# Vývojářské konfigurace a lokální nastavení
.devcontainer/
.idea/
.vscode/
*.swp
*.swo
.streamlit/secrets.toml

# Systémové soubory OS
.DS_Store
Thumbs.db
